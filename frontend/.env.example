# Copy to .env.local for local development. Never commit .env.local.

# Backend API base URL. Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000

# Regional emergency phone number shown on the safety step. Left blank
# by default — no number is invented or hardcoded (README "Secrets &
# Configuration": nothing hard-coded, must be supplied explicitly).
VITE_EMERGENCY_NUMBER=
