# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development                # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string   # used for JWT signing

# --- Database ---
POSTGRES_USER=jeevraksha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jeevraksha
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://jeevraksha:change-me@db:5432/jeevraksha

# --- Auth / JWT ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Object storage (photo/video uploads) ---
# Adapter-based: set STORAGE_PROVIDER to select the implementation.
# Real credentials must be supplied by the deploying team; none are
# invented or defaulted here.
STORAGE_PROVIDER=local              # local | s3 | gcs (adapters added when upload feature lands)
STORAGE_LOCAL_PATH=/data/uploads

# --- Maps / GIS provider ---
MAP_PROVIDER=maplibre               # maplibre | mapbox | google (adapter-based)
MAP_TILE_URL=                       # required if MAP_PROVIDER=maplibre with custom tiles
MAP_PROVIDER_API_KEY=               # required only for providers that need one

# --- ML services ---
ANIMAL_ID_MODEL_VERSION=unset       # set when a real model is registered
RISK_ASSESSMENT_MODEL_VERSION=unset
